# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# VERTEX AI AGENT BUILDER (Google Cloud Deployment)
# ==============================================================================
# When deploying to Google Cloud (Cloud Run / GKE / Compute Engine):
# Cloud Run automatically authenticates using the Service Account (Application Default Credentials).
#
# 1. VERTEX_PROJECT_ID: Your Google Cloud Project ID (e.g. "axon-legal-cloud")
VERTEX_PROJECT_ID=""

# 2. VERTEX_LOCATION: Region of your Vertex AI Agent (e.g. "global" or "us-central1")
VERTEX_LOCATION="global"

# 3. VERTEX_AGENT_ID: ID of your Conversational Agent in Vertex AI Agent Builder
VERTEX_AGENT_ID=""

# 4. VERTEX_DATASTORE_ID: ID of your Data Store (trained with PDFs, documents, URLs of AXON Legal)
VERTEX_DATASTORE_ID=""

# 5. VERTEX_ENGINE_ID: ID of your Search & Conversation Engine (if using Search App)
VERTEX_ENGINE_ID=""

# 6. VERTEX_COLLECTION_ID: Default collection ID (normally "default_collection")
VERTEX_COLLECTION_ID="default_collection"

